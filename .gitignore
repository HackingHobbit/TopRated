# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code — local-only settings (shared launch.json is committed)
.claude/settings.local.json

# python build artifacts (scripts/ uses python for the Clover xlsx ingest)
__pycache__/
*.pyc

# Local Netlify folder
.netlify

# Deno lockfile — generated by Netlify's edge-function bundler, not source
deno.lock
