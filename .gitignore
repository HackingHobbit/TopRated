# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code — local-only settings (shared launch.json is committed)
.claude/settings.local.json

# python build artifacts (scripts/ uses python for the Clover xlsx ingest)
__pycache__/
*.pyc

# Local Netlify folder
.netlify

# Deno lockfile — generated by Netlify's edge-function bundler, not source
deno.lock

# Image-enrichment working files (generated by scripts/enrich_images.py +
# build_review.py) and reviewer output — regenerable, not source.
scripts/image_candidates.json
scripts/image_review.html
scripts/approvals.json

# Portable image-review kit: the real Supabase creds + generated apply/review
# artifacts. The candidate seed (work/image_candidates.json) IS committed so
# the kit is ready to review out of the box.
image-review-kit/.env
image-review-kit/work/image_map.json
image-review-kit/work/image_review.html
image-review-kit/work/approvals.json
